# Multi-stage Dockerfile for PromptScope Frontend/Full-stack Service
# Stage 1: Build static assets and backend node bundle
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY package*.json ./
RUN npm ci

# Copy configuration and source files
COPY tsconfig.json vite.config.ts server.ts index.html ./
COPY src/ ./src/
COPY firebase-applet-config.json* ./

# Build production assets
RUN npm run build

# Stage 2: Production runner
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy package descriptors and built artifacts
COPY package*.json ./
COPY --from=builder /app/dist ./dist
COPY firebase-applet-config.json* ./

# Install only production dependencies
RUN npm ci --only=production

# Healthcheck to ensure the container is up and responding
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "const http = require('http'); const req = http.request('http://localhost:3000/api/firebase-config', {timeout: 2000}, (res) => { if (res.statusCode === 200) process.exit(0); else process.exit(1); }); req.on('error', () => process.exit(1)); req.end();"

EXPOSE 3000

CMD ["npm", "run", "start"]
