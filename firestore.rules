rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default safety deny-all net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User profile schema validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'organization', 'role', 'bio', 'preferences', 'createdAt'])
        && data.keys().size() == 9
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.photoURL is string && data.photoURL.size() <= 512
        && data.organization is string && data.organization.size() <= 128
        && data.role is string && data.role.size() <= 128
        && data.bio is string && data.bio.size() <= 1000
        && data.createdAt is string
        && data.preferences is map
        && data.preferences.keys().hasAll(['defaultModel', 'theme', 'apiUsageLimit'])
        && data.preferences.keys().size() == 3
        && data.preferences.defaultModel is string
        && data.preferences.theme is string
        && data.preferences.apiUsageLimit is int;
    }

    // 2. Prompt execution schema validation
    function isValidPromptExecution(data) {
      return data.keys().hasAll(['userId', 'promptText', 'category', 'timestamp', 'modelsUsed', 'responses', 'averageLatencyMs', 'totalTokens', 'totalCostUsd'])
        && data.userId is string && data.userId.size() <= 128
        && data.promptText is string && data.promptText.size() <= 10000
        && data.category is string && data.category.size() <= 128
        && data.timestamp is string
        && data.modelsUsed is list
        && data.modelsUsed.size() <= 10
        && data.responses is list
        && data.averageLatencyMs is number
        && data.totalTokens is int
        && data.totalCostUsd is number;
    }

    // Matches
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);
    }

    match /executions/{executionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidPromptExecution(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidPromptExecution(incoming()) && (
        // Restrict update to isFavorite flag or typical interaction
        incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
