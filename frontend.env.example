# PromptScope Production Frontend - Environment Variables Configuration

# Node environment state (production / development)
NODE_ENV=production
PORT=3000

# Server-side Gemini API key (Never prefix with VITE_ to prevent client-side leakage)
GEMINI_API_KEY=your-production-google-gemini-api-key-here

# Hosted deployment root URL (Used for secure CORS matching and absolute self-referencing links)
APP_URL=https://promptscope.com

# Backend API proxy target (Defaults to Docker container name when using Docker architecture)
BACKEND_API_URL=http://backend:8000

# Client-side (Public) Firebase Config (Pre-fixed with VITE_ to allow Vite bundler ingestion)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id-here
VITE_FIREBASE_APP_ID=your-firebase-app-id-here
VITE_FIREBASE_MEASUREMENT_ID=your-google-analytics-measurement-id-here

# Client-side (Public) Google Analytics Tracking ID
VITE_ANALYTICS_ID=UA-XXXXXXX-Y
VITE_MIX_PANEL_TOKEN=your-mixpanel-public-token-here
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
