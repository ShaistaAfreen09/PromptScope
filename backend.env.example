# PromptScope Production FastAPI Backend - Environment Variables Configuration

# Global configuration
ENV=production
DEBUG=false
PROJECT_NAME="PromptScope Enterprise API"
VERSION="1.0.0"

# Main PostgreSQL connection string (async pg format required for asyncpg backend ORM)
DATABASE_URL=postgresql+asyncpg://postgres_user:strong_password@db:5432/promptscope_prod

# Enterprise security encryption key (Used to encrypt/decrypt private API keys using AES-256)
# Generate a secure key using: openssl rand -hex 32
ENCRYPTION_KEY=64_character_hexadecimal_encryption_key_goes_here

# Firebase Admin SDK Configuration (Required for secure, server-side JWT ID Token validation)
FIREBASE_PROJECT_ID=ai-studio-a00f3103-1467-4019-a12d-7dd95785e909
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase_credentials.json

# CORS (Allowed Origins - Comma-separated list of origins permitted to issue secure requests)
CORS_ORIGINS=https://promptscope.com,https://app.promptscope.com

# LLM Providers Configuration (Backup and operational credentials)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# Monitoring and Observability Setup
DATADOG_API_KEY=your-datadog-api-key-here
SENTRY_BACKEND_DSN=https://your-backend-sentry-dsn@sentry.io/project-id
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Rate Limiting configuration
DEFAULT_RATE_LIMIT_LIMIT=120
DEFAULT_RATE_LIMIT_WINDOW=60
